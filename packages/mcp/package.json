{
  "name": "express-file-cluster-mcp",
  "version": "0.9.0",
  "description": "MCP server for express-file-cluster (EFC): the framework's docs, rules and scaffolding tools for AI coding agents",
  "homepage": "https://efc.prashantadhikari7.com.np/docs.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pr4shxnt/efc.js.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/pr4shxnt/efc.js/issues"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "efc-mcp": "dist/index.js",
    "express-file-cluster-mcp": "dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "express-file-cluster",
    "efc",
    "ai",
    "agents"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/bundle-docs.mjs dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
